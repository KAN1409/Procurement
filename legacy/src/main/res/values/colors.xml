<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OpenWhispr dual-tone: graphite surfaces, red as the only chromatic
         accent. No blue, no purple, no gradients. -->
    <color name="primary">#B52B32</color>
    <color name="primary_container">#3A0F12</color>
    <color name="on_primary_container">#E99095</color>

    <color name="secondary">#8A8A8A</color>
    <color name="secondary_container">#1D1D1D</color>
    <color name="on_secondary_container">#D8D8D8</color>

    <color name="tertiary">#8C4A4E</color>
    <color name="tertiary_container">#2A1013</color>
    <color name="on_tertiary_container">#D99A9E</color>

    <!-- The surface the app actually paints behind its content, also used for
         the system bars so they blend into the content. -->
    <color name="app_surface">#090909</color>
</resources>
